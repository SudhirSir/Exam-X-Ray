# ==============================================================================
# EXAM X-RAY Environment Configuration
# ==============================================================================
APP_NAME="EXAM X-RAY"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security & JWT (Generate strong random 32+ char secrets in production)
JWT_SECRET_KEY=change-me-in-production-use-64-char-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_SECRET_KEY=change-me-csrf-secret-in-production

# Database
# Production / Docker Compose: postgresql+psycopg2://examxray:examxray@postgres:5432/examxray
# Local Windows dev fallback (without Docker): sqlite:///./exam_xray.db
DATABASE_URL=sqlite:///./exam_xray.db
ENABLE_PGVECTOR=false

# Redis (Optional in local dev; required in Docker/production for rate limit & jobs)
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO Object Storage (Falls back to local ./data/uploads when S3_ENDPOINT is empty)
S3_ENDPOINT=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=exam-xray-documents
LOCAL_STORAGE_DIR=./data/uploads

# PySpark & Medallion Lakehouse Paths
SPARK_MASTER=local[*]
SPARK_APP_NAME=ExamXRayMedallion
MEDALLION_BASE_DIR=./data
USE_DELTA_LAKE=true
JAVA_HOME=C:\Program Files\Java\jdk-23

# AI / Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
ALLOW_MODEL_DOWNLOAD=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=EXAM X-RAY
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
