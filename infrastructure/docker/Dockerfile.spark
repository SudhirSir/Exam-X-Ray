FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jre-headless \
    procps \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PYTHONPATH=/app:/app/data-engineering:/app/apps/api

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir \
    pyspark==4.1.1 \
    delta-spark==4.3.1 \
    sqlalchemy==2.0.38 \
    pydantic==2.10.6 \
    pydantic-settings==2.8.1 \
    psycopg2-binary==2.9.10 \
    structlog==25.1.0 \
    pandas==2.2.3

COPY . /app

CMD ["python", "-c", "from app.core.database import SessionLocal; from pipelines.medallion_runner import execute_medallion_from_db; db = SessionLocal(); print(execute_medallion_from_db(db, trigger_type='spark_worker'))"]
